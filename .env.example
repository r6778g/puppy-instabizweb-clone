# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Used only by server routes that write private records, such as enquiries.
SUPABASE_URL=https://your-project.supabase.co
# Keep this secret on the server. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Resend email notifications for contact form enquiries.
# Verify the sender domain/address in Resend before using it.
RESEND_API_KEY=re_your_resend_api_key
ENQUIRY_FROM_EMAIL=TeddyPups <enquiries@your-verified-domain.com>
ENQUIRY_TO_EMAIL=mohitpaladiya150@gmail.com
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-percent-encoded-password@db.your-project-ref.supabase.co:5432/postgres
